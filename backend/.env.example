# Copie para .env e ajuste os valores para o seu ambiente local.

APP_NAME=Rio-Urbe — Gestão de Contratos
AMBIENTE=development

DATABASE_URL=postgresql+psycopg://riourbe:riourbe@127.0.0.1:5432/riourbe

# Em produção: gerar com `openssl rand -hex 32` (mínimo 32 caracteres, nunca o valor padrão)
JWT_SECRET=dev-secret-change-me-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRA_HORAS=12

# Em produção deve ser "true" (o boot é recusado caso contrário)
COOKIE_SECURE=false
COOKIE_NAME=riourbe_session

# Credenciais do administrador inicial (script scripts/seed_admin.py)
ADMIN_INICIAL_MATRICULA=admin
ADMIN_INICIAL_SENHA=TrocarSenha#2026

CORS_ORIGINS=http://localhost:5173

# Opcional — sem chave, funcionalidades de e-mail ficam indisponíveis (503), boot não falha
BREVO_API_KEY=
BREVO_REMETENTE_EMAIL=

MAX_BODY_SIZE_BYTES=1048576
